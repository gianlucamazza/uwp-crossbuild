<?xml version="1.0" encoding="utf-8"?>
<!-- A target that copies a file into the build: what it produces cannot be reproduced by reading the project. -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><ConfigurationType>Application</ConfigurationType></PropertyGroup>
  <Target Name="StageAssets" BeforeTargets="Build">
    <Copy SourceFiles="a.txt" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
