<?xml version="1.0" encoding="utf-8"?>
<!--
  The static library evaluation.vcxproj references when its Backend property
  selects it. C sources mixed with C++ in one project is the shape that made
  build.sh compile per language rather than per pass.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Globals">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>LIBRARY_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\one.c" />
    <ClCompile Include="src\keep.cpp" />
  </ItemGroup>
</Project>
