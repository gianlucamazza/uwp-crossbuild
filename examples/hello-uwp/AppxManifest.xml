<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity/@Publisher must equal the subject of the signing certificate;
  openappx sign can mint one that matches.

  EntryPoint="hello.App" is resolved at activation against hello.winmd, which
  gen-projection.sh produces from app.idl and build-app.sh copies into the layout.
  Without that file the package installs and then fails to launch.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity
    Name="UwpCrossbuild.HelloUwp"
    Publisher="CN=uwp-crossbuild-dev"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>hello-uwp</DisplayName>
    <PublisherDisplayName>uwp-crossbuild</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="HelloUwp" Executable="hello.exe" EntryPoint="hello.App">
      <uap:VisualElements
        DisplayName="hello-uwp"
        Description="A UWP application compiled on Linux"
        BackgroundColor="#0E1116"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E1116" />
      </uap:VisualElements>
    </Application>
  </Applications>

</Package>
